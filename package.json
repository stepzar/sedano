{
  "name": "sedano",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "A minimal, fast, never-freezing cockpit for coding-agent harnesses (Claude Code, Codex, Gemini CLI, Grok, opencode, Command Code, Freebuff) with live subagent visibility.",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/ui"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun scripts/dev-server.ts",
    "dev:server:watch": "bun scripts/dev-server.ts --watch",
    "dev:ui": "vite --config apps/ui/vite.config.ts",
    "build:ui": "vite build --config apps/ui/vite.config.ts",
    "build:demo": "vite build --config apps/ui/vite.demo.config.ts",
    "dev:demo": "vite --config apps/ui/vite.demo.config.ts",
    "start": "bun run apps/server/src/index.ts",
    "sidecar": "bun run scripts/build-sidecar.ts",
    "desktop": "tauri --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json --config apps/desktop/src-tauri/tauri.dev.conf.json",
    "desktop:build": "bun scripts/desktop-build.ts",
    "install:app": "bun scripts/install-app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ui": "bun scripts/ui-check.ts",
    "check:contrast": "bun scripts/contrast-check.ts",
    "check:csp": "bun scripts/csp-check.ts",
    "check:view": "bun scripts/view-test.ts",
    "check:db": "bun scripts/db-test.ts",
    "check:db-backup": "bun scripts/db-backup-test.ts",
    "check:turn": "bun scripts/turn-test.ts",
    "check:files": "bun scripts/file-links-test.ts",
    "check:resume": "bun scripts/resume-history-test.ts",
    "check:replay": "bun scripts/replay-test.ts",
    "check:coverage": "bun scripts/coverage-test.ts",
    "coverage:extract": "bun scripts/coverage/extract.ts",
    "check:lifecycle": "bun scripts/lifecycle-test.ts",
    "check:dock": "bun scripts/dock-terminal-test.ts",
    "check:recovery": "bun scripts/recovery-test.ts",
    "check:store": "bun scripts/store-test.ts",
    "check:error": "bun scripts/error-test.ts",
    "check:limits": "bun scripts/limits-test.ts",
    "check:limits-ui": "bun scripts/limits-ui-test.ts",
    "check:usage-readers": "bun scripts/usage-readers-test.ts",
    "check:turn-view": "bun scripts/turn-view-test.ts",
    "check:models": "bun scripts/model-test.ts",
    "check:models-ui": "bun scripts/model-ui-test.ts",
    "check:harness-update": "bun scripts/harness-update-test.ts",
    "check:harness-sync": "bun scripts/harness-sync-test.ts",
    "check:transfer": "bun scripts/transfer-test.ts",
    "check:import": "bun scripts/import-test.ts",
    "check:tabs": "bun scripts/tab-order-test.ts",
    "check:tabs-ui": "bun scripts/tab-drag-ui-test.ts",
    "check:follow-ui": "bun scripts/follow-ui-test.ts",
    "check:sticky-ui": "bun scripts/sticky-ui-test.ts",
    "check:minimap-ui": "bun scripts/minimap-ui-test.ts",
    "check:tab-keys-ui": "bun scripts/tab-keys-ui-test.ts",
    "check:tab-sync-ui": "bun scripts/tab-sync-ui-test.ts",
    "check:image-chips-ui": "bun scripts/image-chip-ui-test.ts",
    "check:drafts-ui": "bun scripts/draft-persist-ui-test.ts",
    "check:chip-layout-ui": "bun scripts/chip-layout-ui-test.ts",
    "check:mobile-ui": "bun scripts/mobile-ui-test.ts",
    "check:round-ui": "bun scripts/round-ui-test.ts",
    "check:remote-ui": "bun scripts/remote-ui-test.ts",
    "check:dock-resize-ui": "bun scripts/dock-resize-ui-test.ts",
    "check:conformance": "bun scripts/conformance-test.ts",
    "check:nav": "bun scripts/nav-check.ts",
    "check:settings": "bun scripts/settings-test.ts",
    "check:dictation": "bun scripts/dictation-test.ts",
    "check:settings-ui": "bun scripts/settings-ui-test.ts",
    "check:update-ui": "bun scripts/update-ui-test.ts",
    "check:appearance-ui": "bun scripts/appearance-ui-test.ts",
    "check:discovery": "bun scripts/harness-discovery-test.ts",
    "check:context-window": "bun scripts/context-window-test.ts",
    "check:machine-color": "bun scripts/machine-color-test.ts",
    "check:claude": "bun scripts/claude-test.ts",
    "check:ssh": "bun scripts/ssh-test.ts",
    "check:remote": "bun scripts/remote-test.ts",
    "check:acp": "bun scripts/acp-test.ts",
    "check:cmd": "bun scripts/commandcode-test.ts",
    "check:manager": "bun scripts/manager-test.ts",
    "check:multi": "bun scripts/multi-harness-test.ts",
    "check:ws": "bun scripts/ws-test.ts",
    "check:origin": "bun scripts/origin-test.ts",
    "check:transcript": "bun scripts/transcript-test.ts",
    "check:markdown": "bun scripts/markdown-test.ts",
    "check:dist": "bun scripts/dist-check.ts",
    "check:demo-isolated": "bun scripts/demo-isolated-check.ts",
    "check:demo": "bun scripts/demo-test.ts",
    "check:sidecar": "bun scripts/sidecar-check.ts",
    "check:rust": "bun scripts/rust-check.ts",
    "check:version": "bun scripts/version-check.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "check:echo": "bun scripts/echo-test.ts",
    "check:term-double": "bun scripts/term-double-test.ts",
    "check:term-epipe": "bun scripts/term-epipe-test.ts",
    "check:term": "bun scripts/term-smoke.ts",
    "check:term-ui": "bun scripts/term-ui-smoke.ts",
    "check:smoke": "bun scripts/smoke.ts",
    "check:all": "bun scripts/lib/check-all.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14",
    "marked-footnote": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thinking-orbs": "^0.3.1"
  }
}
