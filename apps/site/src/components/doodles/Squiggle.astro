---
// Hand-drawn underline. Stretches to the width of its positioned parent.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['squiggle', className]} viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
  <path d="M2 7.4C22 3.2 38 10.6 62 6.4S104 2.8 128 6.8 170 9.6 198 4.6" />
  <path d="M5 8.6C26 5.4 44 10.2 66 7.6S108 4.8 132 8.2 168 9.8 194 6.6" opacity="0.4" />
</svg>

<style>
  .squiggle {
    display: block;
    width: 100%;
    height: 10px;
    overflow: visible;
    fill: none;
    stroke: var(--pen);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .squiggle path {
    vector-effect: non-scaling-stroke;
  }
</style>
