---
// Hand-drawn ellipse around a word; draws itself once on load. The words inside
// never wrap apart. `wide` is for a phrase: less side overshoot, so the ellipse
// stays oval instead of flattening and spilling off a phone screen.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['circled', className]}>
  <slot />
  <svg viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true">
    <path
      pathLength="1"
      d="M36 14.6C78 1.8 168 3.4 190 28.4 203.4 47.8 164 74.6 100 75.4 40.6 76.2 5.2 61.4 6.4 40.6 7.6 19.8 52 7.4 128 8.6"
    />
  </svg>
</span>

<style>
  .circled {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .circled svg {
    position: absolute;
    left: -14%;
    top: -16%;
    width: 128%;
    max-width: none;
    height: 132%;
    overflow: visible;
    pointer-events: none;
  }
  .wide svg {
    left: -7%;
    width: 115%;
    top: -8%;
    height: 132%;
  }
  .circled path {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .circled path {
      animation: draw 900ms var(--ease) 250ms both;
    }
  }
  /* Chrome measures pathLength in screen space once the stroke is non-scaling,
     so on a stretched ellipse a dash of 1 covers only part of it. A longer
     dash still draws the whole line. */
  .wide path {
    stroke-dasharray: 4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wide path {
      animation-name: draw-wide;
    }
  }
  @keyframes draw-wide {
    from {
      stroke-dashoffset: 4;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
