---
// Double-stroke hand-drawn frame with overshooting corners. Wraps screenshots.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['sketch-frame', className]}>
  <slot />
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M2.7 0.9Q50.9 1.5 99.3 0.9M98.8 1.8Q98.3 51.6 98.7 100.2M98.2 98.9Q48.7 99.1 -0.3 99.2M1.2 100.7Q0.8 50.3 1.2 0.8" />
    <path d="M1.8 1.1Q50.9 1 100.1 1.5M99 1Q99.6 50.3 99 99.6M98.6 98.9Q49 98.5 0.5 99.3M1.2 99.8Q1.9 50.6 1.5 -0.1" opacity="0.5" />
  </svg>
</div>

<style>
  .sketch-frame {
    position: relative;
    padding: var(--s-3);
  }
  .sketch-frame > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .sketch-frame path {
    vector-effect: non-scaling-stroke;
  }
</style>
