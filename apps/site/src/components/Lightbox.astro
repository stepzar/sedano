---
// Loads the screenshot lightbox once per page (Astro dedupes the script) and
// styles the dialog it creates. Mark a screenshot with <a class="zoomable" href=…>.
---

<script>
  import '../scripts/lightbox';
</script>

<style is:global>
  a.zoomable {
    display: block;
    cursor: zoom-in;
    border-radius: var(--r-1);
  }
  a.zoomable:focus-visible {
    outline: 2px solid var(--pen);
    outline-offset: 3px;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ece9e2;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(16, 15, 14, 0.94);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  /* Flex, not grid: the image's max-height: 100% needs a definite parent height,
     which an auto grid row inside the stage would not give it. */
  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 16px;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-out;
  }
  .lb-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    min-width: 0;
    min-height: 0;
    width: auto;
    height: auto;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
    transform-origin: center;
    cursor: zoom-in;
    user-select: none;
    -webkit-user-select: none;
  }
  .lb-stage.is-zoomed .lb-img {
    cursor: grab;
  }
  .lb-stage.is-dragging .lb-img {
    cursor: grabbing;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lb-stage:not(.is-dragging) .lb-img {
      transition: transform 160ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .lightbox[open] .lb-stage {
      animation: lb-in 160ms ease-out;
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
  .lb-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    padding: 8px 16px max(12px, env(safe-area-inset-bottom));
  }
  .lb-caption {
    flex: 1;
    margin: 0;
    font: 400 0.875rem/1.45 var(--font-sans);
    color: #d6d3cb;
    order: -1;
  }
  .lb-count {
    font: 0.8125rem var(--font-mono);
    color: #938a77;
    white-space: nowrap;
  }
  .lb-btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid rgba(236, 233, 226, 0.55);
    border-radius: 10px;
    background: transparent;
    color: #ece9e2;
    font: 500 1.25rem/1 var(--font-sans);
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: #ece9e2;
    background: rgba(255, 255, 255, 0.08);
  }
  .lb-btn:focus-visible {
    outline: 2px solid #7aa2ff;
    outline-offset: 2px;
  }
  .lb-btn[hidden],
  .lb-count[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .lb-bar {
      flex-wrap: wrap;
    }
    .lb-caption {
      flex-basis: 100%;
    }
  }
</style>
