{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window only needs the webview; every capability lives in the local sedano server.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
